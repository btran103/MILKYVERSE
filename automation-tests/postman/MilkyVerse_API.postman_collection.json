          "raw": "{{baseUrl}}/orders",
          "host": ["{{baseUrl}}"],
          "path": ["orders"]
        }
      }
    },
    {
      "name": "8. AI Barista - Gợi ý đồ uống theo tâm trạng",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code phản hồi hợp lệ\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 404]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
