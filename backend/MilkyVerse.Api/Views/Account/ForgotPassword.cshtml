@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Quên Mật Khẩu Xác Thực OTP";
}

<div class="mv-card">
    <h1 class="mv-title" id="fpTitle">Khôi Phục Mật Khẩu</h1>
    <p class="mv-subtitle" id="fpSubtitle">Quy trình 3 bước bảo mật: Nhập Email &rarr; Xác thực OTP (5 phút) &rarr; Đặt mật khẩu mới</p>

    <div id="alertError" class="mv-alert mv-alert-error"></div>
    <div id="alertSuccess" class="mv-alert mv-alert-success"></div>

    <!-- BƯỚC 1: NHẬP EMAIL ĐÃ ĐĂNG KÝ -->
    <form id="fpStep1" onsubmit="sendForgotOtp(event)">
        <label class="mv-label">Email tài khoản đã đăng ký *</label>
        <input type="email" id="fpEmail" class="mv-input" required placeholder="ten@gmail.com" />
        <button type="submit" id="btnFpSend" class="mv-btn">Gửi Mã Xác Thực OTP (6 Chữ Số)</button>
    </form>

    <!-- BƯỚC 2: XÁC THỰC MÃ OTP -->
    <form id="fpStep2" style="display:none;" onsubmit="verifyForgotOtp(event)">
        <div class="mv-timer-box">
            <span>⏳ Hiệu lực OTP còn lại:</span>
            <span id="fpTimer" style="color:#B91C1C;font-family:monospace;font-size:15px;">05:00</span>
        </div>

        <label class="mv-label" style="text-align:center;">Nhập mã OTP 6 chữ số từ Email</label>
        <input type="text" id="fpOtp" maxlength="6" class="mv-input mv-otp-input" required placeholder="••••••" />

        <button type="submit" class="mv-btn">Xác Thực Mã OTP</button>
        <button type="button" id="btnFpResend" class="mv-btn mv-btn-outline" onclick="sendForgotOtp(null)">Gửi lại mã OTP</button>
    </form>

    <!-- BƯỚC 3: ĐẶT MẬT KHẨU MỚI & XÁC NHẬN -->
    <form id="fpStep3" style="display:none;" onsubmit="submitNewPassword(event)">
        <label class="mv-label">Mật khẩu mới (Tối thiểu 8 ký tự, chữ Hoa, thường, số, ký tự đặc biệt) *</label>
        <input type="password" id="fpNewPass" class="mv-input" required placeholder="Nhập mật khẩu mới..." />

        <label class="mv-label">Xác nhận mật khẩu mới *</label>
        <input type="password" id="fpConfirmPass" class="mv-input" required placeholder="Nhập lại mật khẩu mới..." />

        <button type="submit" class="mv-btn">Lưu Mật Khẩu Mới &amp; Vô Hiệu Hóa OTP</button>
    </form>
</div>

<script>
    let fpExpiry = 300;
    let fpCooldown = 0;
    let fpInterval = null;

    function showErr(msg) {
        const el = document.getElementById('alertError');
        el.innerText = msg;
        el.style.display = 'block';
        document.getElementById('alertSuccess').style.display = 'none';
    }

    function showOk(msg) {
        const el = document.getElementById('alertSuccess');
        el.innerText = msg;
        el.style.display = 'block';
        document.getElementById('alertError').style.display = 'none';
    }

    function startFpTimer(exp, cd) {
        fpExpiry = exp || 300;
        fpCooldown = cd || 60;
        if (fpInterval) clearInterval(fpInterval);
        fpInterval = setInterval(() => {
            if (fpExpiry > 0) fpExpiry--;
            const m = String(Math.floor(fpExpiry / 60)).padStart(2, '0');
            const s = String(fpExpiry % 60).padStart(2, '0');
            document.getElementById('fpTimer').innerText = `${m}:${s}`;

            const btn = document.getElementById('btnFpResend');
            if (fpCooldown > 0) {
                fpCooldown--;
                btn.disabled = true;
                btn.innerText = `Gửi lại mã OTP (${fpCooldown}s)`;
            } else {
                btn.disabled = false;
                btn.innerText = 'Gửi lại mã OTP';
            }
        }, 1000);
    }

    async function sendForgotOtp(e) {
        if (e) e.preventDefault();
        const email = document.getElementById('fpEmail').value.trim();
        const res = await fetch('/api/auth/send-otp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, purpose: 'forgot-password' })
        });
        const json = await res.json();
        if (!res.ok || !json.success) {
            showErr(json.message || 'Không thể gửi mã OTP.');
            return;
        }
        document.getElementById('fpStep1').style.display = 'none';
        document.getElementById('fpStep2').style.display = 'block';
        showOk(`Đã gửi mã OTP 6 chữ số từ milkyverse103@gmail.com tới hộp thư ${email}. Vui lòng mở Gmail để lấy mã.`);
        startFpTimer(json.data?.expiresInSeconds || 300, json.data?.resendCooldownSeconds || 60);
    }

    async function verifyForgotOtp(e) {
        e.preventDefault();
        const email = document.getElementById('fpEmail').value.trim();
        const code = document.getElementById('fpOtp').value.trim();
        const res = await fetch('/api/auth/verify-otp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, code, purpose: 'forgot-password' })
        });
        const json = await res.json();
        if (!res.ok || !json.success) {
            showErr(json.message || 'Mã OTP không chính xác.');
            return;
        }
        document.getElementById('fpStep2').style.display = 'none';
        document.getElementById('fpStep3').style.display = 'block';
        showOk('Xác thực OTP thành công! Mời bạn nhập mật khẩu mới.');
    }

    async function submitNewPassword(e) {
        e.preventDefault();
        const email = document.getElementById('fpEmail').value.trim();
        const code = document.getElementById('fpOtp').value.trim();
        const newPassword = document.getElementById('fpNewPass').value;
        const confirmPassword = document.getElementById('fpConfirmPass').value;

        if (newPassword !== confirmPassword) {
            showErr('Mật khẩu xác nhận không trùng khớp.');
            return;
        }

        const res = await fetch('/api/auth/reset-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, code, newPassword, confirmPassword })
        });
        const json = await res.json();
        if (!res.ok || !json.success) {
            showErr(json.message || 'Đổi mật khẩu thất bại.');
            return;
        }
        showOk(json.message);
        setTimeout(() => { window.location.href = '/Account/Login'; }, 1800);
    }
</script>
